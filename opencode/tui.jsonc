{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "flexoki",
  "keybinds": {
    "leader": "ctrl+x",
    "app_exit": "<leader>q", // "ctrl+c,ctrl+d,<leader>q"
    "app_debug": "none",
    "app_console": "none",
    "app_heap_snapshot": "none",
    "app_toggle_animations": "none",
    "app_toggle_file_context": "none",
    "app_toggle_diffwrap": "none",
    "app_toggle_paste_summary": "none",
    "app_toggle_session_directory_filter": "none",
    "command_list": "<leader>p",
    "help_show": "none",
    "docs_open": "none",

    "editor_open": "none", // "<leader>e"
    "theme_list": "none", // "<leader>t"
    "theme_switch_mode": "none",
    "theme_mode_lock": "none",
    "sidebar_toggle": "<leader>b",
    "scrollbar_toggle": "<leader>i", // "none"
    "status_view": "none", // "<leader>s"

    "session_export": "none", // "<leader>x"
    "session_copy": "none",
    "session_move": "none",
    "session_new": "none", // "<leader>n"
    "session_list": "none", // "<leader>l"
    "session_timeline": "none", // "<leader>g"
    "session_fork": "none",
    "session_rename": "ctrl+r",
    "session_delete": "ctrl+d",
    "session_share": "none",
    "session_unshare": "none",
    "session_interrupt": "escape",
    "session_compact": "none", // "<leader>c"
    "session_toggle_timestamps": "none",
    "session_toggle_generic_tool_output": "none",
    "session_child_first": "none", // "<leader>down"
    "session_child_cycle": "none", // "right"
    "session_child_cycle_reverse": "none", // "left"
    "session_parent": "none", // "up"

    "stash_delete": "none", // "ctrl+d",
    "model_provider_list": "none", // "ctrl+a"
    "model_favorite_toggle": "none", // "ctrl+f"
    "model_list": "none", // "<leader>m"
    "model_cycle_recent": "none", // "f2"
    "model_cycle_recent_reverse": "none", // "shift+f2"
    "model_cycle_favorite": "none",
    "model_cycle_favorite_reverse": "none",
    "mcp_list": "none",
    "provider_connect": "none",
    "console_org_switch": "none",
    "agent_list": "none", // "<leader>a"
    "agent_cycle": "tab",
    "agent_cycle_reverse": "shift+tab",
    "variant_cycle": "none", // "ctrl+t"
    "variant_list": "none",

    "messages_page_up": "pageup", // "pageup,ctrl+alt+b"
    "messages_page_down": "pagedown", // "pagedown,ctrl+alt+f"
    "messages_line_up": "none", // "ctrl+alt+y"
    "messages_line_down": "none", // "ctrl+alt+e"
    "messages_half_page_up": "none", // "ctrl+alt+u"
    "messages_half_page_down": "none", // "ctrl+alt+d"
    "messages_first": "home", // "ctrl+g,home"
    "messages_last": "end", // "ctrl+alt+g,end"
    "messages_next": "none",
    "messages_previous": "none",
    "messages_last_user": "none",
    "messages_copy": "<leader>c", // "<leader>y"
    "messages_undo": "none", // "<leader>u"
    "messages_redo": "none", // "<leader>r"
    "messages_toggle_conceal": "none", // "<leader>h"
    "tool_details": "none",
    "display_thinking": "none",

    "prompt_submit": "none",
    "prompt_editor_context_clear": "none",
    "prompt_skills": "none",
    "prompt_stash": "none",
    "prompt_stash_pop": "none",
    "prompt_stash_list": "none",
    "workspace_set": "none",

    "input_clear": "none", // "ctrl+c"
    "input_paste": {
      "key": "ctrl+v",
      "preventDefault": false,
    },
    "input_submit": "ctrl+return", // "return"
    "input_newline": "return", // "shift+return,ctrl+return,alt+return,ctrl+j"
    "input_move_left": "left", // "left,ctrl+b"
    "input_move_right": "right", // "right,ctrl+f"
    "input_move_up": "up",
    "input_move_down": "down",
    "input_select_left": "shift+left",
    "input_select_right": "shift+right",
    "input_select_up": "shift+up",
    "input_select_down": "shift+down",
    "input_line_home": "none", // "ctrl+a"
    "input_line_end": "none", // "ctrl+e"
    "input_select_line_home": "none", // "ctrl+shift+a"
    "input_select_line_end": "none", // "ctrl+shift+e"
    "input_visual_line_home": "none", // "alt+a"
    "input_visual_line_end": "none", // "alt+e"
    "input_select_visual_line_home": "none", // "alt+shift+a"
    "input_select_visual_line_end": "none", // "alt+shift+e"
    "input_buffer_home": "none", // "home"
    "input_buffer_end": "none", // "end"
    "input_select_buffer_home": "none", // "shift+home"
    "input_select_buffer_end": "none", // "shift+end"
    "input_delete_line": "none", // "ctrl+shift+d"
    "input_delete_to_line_end": "none", // "ctrl+k"
    "input_delete_to_line_start": "none", // "ctrl+u"
    "input_backspace": "backspace", // "backspace,shift+backspace"
    "input_delete": "delete", // "ctrl+d,delete,shift+delete"
    "input_undo": "none", // "ctrl+-,super+z"
    "input_redo": "none", // "ctrl+.,super+shift+z"
    "input_word_forward": "ctrl+right", // "alt+f,alt+right,ctrl+right"
    "input_word_backward": "ctrl+left", // "alt+b,alt+left,ctrl+left"
    "input_select_word_forward": "ctrl+shift+right", // "alt+shift+f,alt+shift+right"
    "input_select_word_backward": "ctrl+shift+left", // "alt+shift+b,alt+shift+left"
    "input_delete_word_forward": "ctrl+delete", // "alt+d,alt+delete,ctrl+delete"
    "input_delete_word_backward": "ctrl+backspace", // "ctrl+w,ctrl+backspace,alt+backspace"
    "input_select_all": "ctrl+a", // "super+a"
    "history_previous": "up",
    "history_next": "down",

    "dialog.select.prev": "up", // "up,ctrl+p"
    "dialog.select.next": "down", // "down,ctrl+n"
    "dialog.select.page_up": "none", // "pageup"
    "dialog.select.page_down": "none", // "pagedown"
    "dialog.select.home": "none", // "home"
    "dialog.select.end": "none", // "end"
    "dialog.select.submit": "return,tab", // "return"
    "dialog.prompt.submit": "return",
    "dialog.mcp.toggle": "none", // "space"
    "prompt.autocomplete.prev": "up", // "up,ctrl+p"
    "prompt.autocomplete.next": "down", // "down,ctrl+n"
    "prompt.autocomplete.hide": "escape",
    "prompt.autocomplete.select": "return",
    "prompt.autocomplete.complete": "tab",
    "permission.prompt.fullscreen": "none", // "ctrl+f"
    "plugins.toggle": "space",
    "dialog.plugins.install": "shift+i",

    "terminal_suspend": "none", // "ctrl+z"
    "terminal_title_toggle": "none",
    "tips_toggle": "none", // "<leader>h"
    "plugin_manager": "none",
    "plugin_install": "none",

    "which_key_toggle": "none", // "ctrl+alt+k"
    "which_key_layout_toggle": "none", // "ctrl+alt+shift+k"
    "which_key_pending_toggle": "none", // "ctrl+alt+shift+p"
    "which_key_group_previous": "none", // "ctrl+alt+left,ctrl+alt+["
    "which_key_group_next": "none", // "ctrl+alt+right,ctrl+alt+]"
    "which_key_scroll_up": "none", // "ctrl+alt+up,ctrl+alt+p"
    "which_key_scroll_down": "none", // "ctrl+alt+down,ctrl+alt+n"
    "which_key_page_up": "none", // "ctrl+alt+pageup"
    "which_key_page_down": "none", // "ctrl+alt+pagedown"
    "which_key_home": "none", // "ctrl+alt+home"
    "which_key_end": "none", // "ctrl+alt+end"
  },
  "scroll_speed": 5,
  "scroll_acceleration": {
    "enabled": false,
  },
  "diff_style": "auto",
  "cursor": {
    "style": "line",
    "blinking": true,
  },
  "mouse": true,
  "attention": {
    "enabled": false,
  },
}
