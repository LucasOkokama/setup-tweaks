{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 2000,
    "hostname": "127.0.0.1",
    "mdns": false,
    "mdnsDomain": "opencode.local",
  },
  "model": "opencode/nemotron-3-ultra-free",
  "share": "disabled",
  "snapshot": true,
  "autoupdate": true,
  "lsp": true,
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000,
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "out/**",
      ".next/**",
      ".turbo/**",
      ".nx/**",
      ".cache/**",
      ".parcel-cache/**",
      ".vite/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
    ],
  },
}
