{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 2000,
    "hostname": "127.0.0.1",
    "mdns": false,
    "mdnsDomain": "opencode.local",
  },
  "model": "opencode/nemotron-3-ultra-free",
  "provider": {
    "google": {
      "whitelist": [
        /*
          MODELS --> https://ai.google.dev/gemini-api/docs/models
          KEY --> https://aistudio.google.com/api-keys
          PROJECT --> https://console.cloud.google.com/cloud-resource-manager
          USAGE --> https://aistudio.google.com/usage
          RATE LIMIT --> https://aistudio.google.com/rate-limit
        */
        "gemini-3.7-flash",
        "gemini-3.6-flash",
        "gemini-3.5-flash",
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite",
      ],
    },
    "nvidia": {
      /*
        MODELS --> https://build.nvidia.com/models
        KEY --> https://build.nvidia.com/settings/api-keys
      */
      "whitelist": [
        "deepseek-ai/deepseek-v4-pro-0813",
        "moonshotai/kimi-k3",
        "openai/gpt-oss-120b",
        "nvidia/nemotron-3-ultra-550b-a55b",
        "deepseek-ai/deepseek-v4-flash-0731",
        "nvidia/nemotron-3-super-120b-a12b",
        "openai/gpt-oss-20b",
        "nvidia/nemotron-3.5-lightning-30b-a3b",
      ],
    },
    "mistral": {
      /*
        MODELS --> https://docs.mistral.ai/models
        KEY --> https://console.mistral.ai/api-keys
        USAGE --> https://admin.mistral.ai/organization/usage
        RATE LIMIT --> https://admin.mistral.ai/plateforme/limits
      */
      "whitelist": [
        "mistral-medium-latest",
        "mistral-small-latest",
        "ministral-8b-latest",
        "ministral-3b-latest",
      ],
    },
    "openrouter": {
      /*
        MODELS --> https://openrouter.ai/models
        KEY --> https://openrouter.ai/workspaces/default/keys
        ACTIVITY --> https://openrouter.ai/activity
      */
      "whitelist": [
        "z-ai/glm-5.2:free",
        "minimax/minimax-m3:free",
        "minimax/minimax-m2.7:free",
        "cohere/north-mini-code:free",
        "thinkingmachines/inkling:free",
        "poolside/laguna-s-2.1:free",
        "thinkingmachines/inkling-small:free",
        "poolside/laguna-xs-2.1:free",
      ],
    },
  },
  "share": "disabled",
  "snapshot": true,
  "autoupdate": true,
  "lsp": true,
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000,
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "out/**",
      ".next/**",
      ".turbo/**",
      ".nx/**",
      ".cache/**",
      ".parcel-cache/**",
      ".vite/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
    ],
  },
}
